# Shared external version pins, read by the Makefile and CI.
# The registry's own release version is NOT pinned here.
# It is defined as part of the schema_url in model/manifest.yaml.

# renovate: datasource=github-releases depName=open-telemetry/weaver versioning=semver-coerced
WEAVER_VERSION=v0.28.0

# Open Policy Agent, used only to unit-test the rego policies under policies/.
# renovate: datasource=github-releases depName=open-policy-agent/opa versioning=semver-coerced
OPA_VERSION=v1.21.4

# chloggen, the changelog entry tool also used by the core semantic conventions. The Makefile
# runs it with `go run`, so it only needs Go on PATH.
# renovate: datasource=go depName=go.opentelemetry.io/build-tools/chloggen versioning=semver-coerced
CHLOGGEN_VERSION=v0.30.0

# The core OpenTelemetry semantic conventions registry this one extends is NOT pinned here.
# Weaver reads model/manifest.yaml directly as its single source of truth, and Renovate bumps it there.
# See .github/renovate.json5.

# renovate: datasource=git-refs depName=open-telemetry/opentelemetry-weaver-packages versioning=git ref=main
POLICY_REPO_URL=https://github.com/open-telemetry/opentelemetry-weaver-packages.git
POLICY_REPO_REF=b524723bedec1cc8d9ef83c924a231348a669ebe
